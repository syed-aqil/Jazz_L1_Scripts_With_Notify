{
  "name": "landing",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug",
    "test:ui": "npx playwright test --ui",
    "test:report": "npx playwright show-report",
    "test:docker": "docker-compose up --build",
    "test:docker:run": "docker-compose run --rm playwright-tests npx playwright test",
    "install:playwright": "npx playwright install --with-deps",
    "install:browsers": "npx playwright install",
    "install:deps": "npx playwright install-deps",
    "build:docker": "docker build -t playwright-tests .",
    "clean:reports": "rm -rf playwright-report test-results allure-results",
    "serve:report": "npx playwright show-report --host 0.0.0.0 --port 9323"
  },
  "keywords": ["playwright", "testing", "automation"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.6.2"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "imap": "^0.8.19",
    "mailparser": "^3.7.4",
    "playwright": "^1.56.1"
  },
  "type": "commonjs",
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eConceptions-Automation/Jazz-Landing-Pages.git"
  },
  "bugs": {
    "url": "https://github.com/eConceptions-Automation/Jazz-Landing-Pages/issues"
  },
  "homepage": "https://github.com/eConceptions-Automation/Jazz-Landing-Pages#readme",
  "description": "Playwright automation tests for L1 landing pages"
}