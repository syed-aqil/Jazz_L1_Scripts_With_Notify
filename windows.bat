@echo off
setlocal
echo Installing Playwright and dependencies...
call npm run install-playwright -y
echo Cleaning old playwright results...
if exist playwright-report rmdir /s /q playwright-report
echo Cleaning old test results...
if exist playwright-report rmdir /s /q test-results
echo Deleting PNG files...
del *.png
echo Running Playwright tests on Wifi...
call npx playwright test
echo Running Playwright tests on Wifi...
call npx playwright show-report

echo Press any key to exit...
pause >nul
